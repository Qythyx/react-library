{
	"author": "",
	"description": "Reusable React library projects",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@semantic-release/git": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest-dom": "^5.5.0",
		"eslint-plugin-jsdoc": "^63.0.1",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"knip": "^6.15.0",
		"npm-check-updates": "^22.2.1",
		"semantic-release": "^25.0.3",
		"ts-jest": "^29.4.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./eslint-rules/*": "./eslint-rules/*.js"
	},
	"files": [
		"dist",
		"public/locales",
		"eslint-rules"
	],
	"keywords": [
		"react",
		"components",
		"hooks",
		"mui",
		"material-ui"
	],
	"license": "MIT",
	"name": "@qythyx/react-library",
	"peerDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.0.1",
		"@mui/material": "^9.0.1",
		"i18next": "^26.3.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.8",
		"react-modal": "^3.16.3",
		"react-router-dom": "^7.16.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsc",
		"build:dist": "tsc -p tsconfig.build.json",
		"build:tsc": "tsc",
		"build:tsc:watch": "tsc --watch",
		"build:watch": "tsc --watch",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"depcheck": "knip && npm-check-updates --peer --target minor --pre 0",
		"deps:major": "npm-check-updates -i --peer --format group --pre 0",
		"deps:update": "npm-check-updates -u --peer --target minor --pre 0 && npm install && npm run build && npm test",
		"dev": "vite",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch"
	},
	"type": "module",
	"version": "2.1.0"
}
